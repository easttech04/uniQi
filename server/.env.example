# MongoDB Connection String
# Replace this with your own MongoDB connection string from a service like MongoDB Atlas.
ATLAS_URI="mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority"

# JWT Secret
# This is a secret key for signing JSON Web Tokens.
# You can use a long, random string.
JWT_SECRET="your_jwt_secret_here"
